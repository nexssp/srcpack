@include "../../../bundles/manage/manage_reports.nflow"

parallel {
  target_empty: const @{ config: { targets: {} } } -> manage_reports.pipeline.target_list_report,
  target_list: const @{ config: { targets: { zeta: { paths: ["src"], dir: [{path: "internal"}], files: ["main.go"], targets: ["shared"] }, alpha: { paths: ["api", "pkg"] } } } } -> manage_reports.pipeline.target_list_report,
  target_show: const @{ config: { targets: { api: { description: "API sources", paths: ["src"], dir: [{path: "internal"}], files: ["README.md"], targets: ["shared"] } } }, args: ["api"] } -> manage_reports.pipeline.target_show_report,
  prompt_list: const @{ config: { prompts: { brief: "Be direct and concise", zeta: "last" } }, prompt_snippets: { brief: "Be direct and concise", zeta: "last" } } -> manage_reports.pipeline.prompt_list_report,
  prompt_show: const @{ config: { prompts: { brief: "Be direct and concise" } }, args: ["brief"] } -> manage_reports.pipeline.prompt_show_report,
  profile_show: const @{ config: { profiles: { review: { name: "review", description: "Review profile", prompt: { Value: "brief", Set: true, Disabled: false } } } }, args: ["review"] } -> manage_reports.pipeline.profile_show_report,
  profile_muted: const @{ config: { profiles: { muted: { name: "muted", description: "Muted profile", prompt: { Value: "brief", Set: true, Disabled: true } } } }, args: ["muted"] } -> manage_reports.pipeline.profile_show_report,
  editor_show: const @{ config: { editors: { custom: { description: "Custom format", file_start: "<file>", file_end: "</file>" } } }, args: ["custom"] } -> manage_reports.pipeline.editor_show_report,
  view_empty: const @{ views: {} } -> manage_reports.pipeline.view_list_report,
  view_list: const @{ views: { saved: ["src#arch", "pkg#source"] } } -> manage_reports.pipeline.view_list_report,
  view_show: const @{ args: ["saved"], report_name: "saved", result: { value: ["src#arch", "pkg#source"] } } -> manage_reports.pipeline.view_show_report,
  view_delete: const @{ name: "saved" } -> manage_reports.pipeline.view_delete_report,
}
-> {
  target_empty: .target_empty.content,
  target_list: .target_list.content,
  target_show: .target_show.content,
  prompt_list: .prompt_list.content,
  prompt_show: .prompt_show.content,
  profile_show: .profile_show.content,
  profile_muted: .profile_muted.content,
  editor_show: .editor_show.content,
  view_empty: .view_empty.content,
  view_list: .view_list.content,
  view_show: .view_show.content,
  view_delete: .view_delete.content
}

@test: result.target_empty == "No targets defined.\n"
@test: result.target_list == "  alpha                [api, pkg]\n  zeta                 [src, internal, main.go, shared]\n"
@test: result.target_show == "target: api\n  description: API sources\n  path: src\n  dir:  internal\n  file: README.md\n  include: shared\n"
@test: result.prompt_list contains "  brief" && result.prompt_list contains "Be direct and concise" && result.prompt_list contains "  zeta"
@test: result.prompt_show == "Be direct and concise\n"
@test: result.profile_show contains "profile: review\n" && result.profile_show contains "  prompt: brief\n"
@test: result.profile_muted contains "profile: muted\n" && !(result.profile_muted contains "  prompt:")
@test: result.editor_show == "editor: custom\n  description: Custom format\n  file_start: <file>\n  file_end: </file>\n"
@test: result.view_empty contains "No views saved." && result.view_list contains "src#arch  pkg#source"
@test: result.view_show == "view: saved\n  src#arch\n  pkg#source\n" && result.view_delete == "✓ Removed view \"saved\"\n"
