@include "../../../bundles/config_cli/config.nflow"

parallel {
  missing_path: const @{ path: "" }
    -> config.pipeline.config_path_policy,
  configured_path: const @{ path: "nexss.srcpack.yml" }
    -> config.pipeline.config_path_policy,
  missing_validation: const @{ path: "" }
    -> config.pipeline.config_validation_policy,
  configured_validation: const @{ path: "nexss.srcpack.yml" }
    -> config.pipeline.config_validation_policy,
}

@test: result.missing_path.text == "(no config file present)"
@test: result.configured_path.text == "nexss.srcpack.yml"
@test: result.missing_validation.action == config.failure.error && result.missing_validation.kind == config.failure.validation && result.missing_validation.message contains "no config file found"
@test: result.configured_validation.action == "validate"
