@description "One target's Flow-driven pack update"
@require github.com/nexssp/srcpack/bundles/update/nexssflow
@require github.com/nexssp/srcpack/bundles/cliinput/nexssflow
@require github.com/nexssp/srcpack/bundles/pack/nexssflow
@include "../pack/pack_workflow.nflow"

@pipeline update_item
  match {
    "request" in keys(.)
      -> pick @{ field: "request" },
    _
      -> { kind: "update", message: "update: item is missing its pack request" }
      -> fail
  }
  -> cli.restore
  -> pack_workflow.pipeline.pack_resolve
  -> pack_workflow.pipeline.pack_execute
@end
