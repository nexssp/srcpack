@description "Regenerate each configured srcpack target through the pack pipeline"
@require github.com/nexssp/srcpack/bundles/update
@require github.com/nexssp/srcpack/bundles/pack
@require github.com/nexssp/srcpack/bundles/cliinput
@require github.com/nexssp/srcpack
@require github.com/nexssp/srcpack/bundles/terminal
@include "update_item.nflow"
@include "update_policy.nflow"

@schema UpdateInput struct {
  profile      string  `cli:"profile,p" usage:"Profile to use for every configured target (default when omitted)"`
  profile_arg  string  `cli:"positional" usage:"Profile shorthand, for example: update arch"`
  check        bool  `cli:"check,diff,dry-run" usage:"Preview target outputs without writing files"`
  quiet        bool  `cli:"quiet,q" usage:"Suppress per-target completion lines"`
}

@schema UpdatePackRequest struct {
  selectors        []string
  profile          string
  check            bool
  quiet            bool
  _output_path     string `json:"_output_path"`
  _command         string `json:"_command"`
  _explicit_pack   bool   `json:"_explicit_pack"`
  _derived_request bool   `json:"_derived_request"`
}
@schema UpdateTargetItem struct {
  request UpdatePackRequest
  target  string
  file    string
  status  string
}
@schema UpdateTargetPlan struct {
  profile        string
  output_profile string
  check          bool
  quiet          bool
  target_names   []string
  output_prefix  string
  items          []UpdateTargetItem
}
@pipeline update_target_item
  :request-schema=UpdateTargetItem
  update_item.pipeline.update_item
  ? on_error {
    else
    -> { update_success: false, update_error: .error.message }
  }
  -> {
    target: input.target,
    file: input.file,
    status: input.status,
    ok: .update_success ?? true,
    error: .update_error ?? ""
  }
@end
@pipeline update_target_plan
  :response-schema=UpdateTargetPlan
  update_policy.@update_target_plan()
@end

@pipeline update
  :cli="update:Regenerate every configured target"
  :request-schema=UpdateInput
  cli.restore
  -> updatecmd.targets
  -> pipeline.update_target_plan
  -> parallel {
    results: (distribute.map ( action: pipeline.update_target_item, items, concurrency: 1, fail_fast: false )),
    plan: { items, check, quiet, profile }
  }
  -> {
    ...,
    joined_rows: map(.results.Items, (
        {
          target: #.OK ? #.Result.target : "(unknown)",
          file: #.OK ? #.Result.file : "",
          status: #.OK ? #.Result.status : "",
          result_present: #.OK,
          ok: #.OK ? #.Result.ok : false,
          error: #.OK ? (#.Result.error ?? "") : (#.Error ?? "")
        }
    ))
  }
  -> update_policy.@update_outcomes()
  -> update_policy.@update_report()
  -> {
    ...,
    content: join(map(.summary.outcomes,
      terminal.printf("  %s %-20s %s\n", #.icon, #.label, #.detail)
    ), "") + (len(.summary.outcomes) > 0 ? "\n" : "") + .summary.message + "\n",
    stream: "stdout"
  }
  -> cli.print
  -> match {
    .summary.failed > 0
    -> { kind: "update", message: string(.summary.failed) + " target(s) failed" }
    -> fail,
    _
    -> cli.finish
  }
@end
