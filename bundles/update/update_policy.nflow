@description "Pure update target planning, outcome, and report policy"

@symbols update_status {
  checked: "CHECKED"
  wrote: "WROTE"
}

@macro update_target_plan() {
  {
    let explicit_profile = string(.profile ?? "");
    let positional_profile = string(.profile_arg ?? "");
    ...,
    profile: explicit_profile != "" ? explicit_profile : positional_profile,
    output_profile: explicit_profile != "" ? explicit_profile : (positional_profile != "" ? positional_profile : "default"),
    check: (.check ?? false) == true,
    quiet: (.quiet ?? false) == true,
    target_names: map(.target_names, string(#)),
    output_prefix: string(.output_prefix ?? "")
  }
  -> {
    ...,
    items: let root = .; map(len(root.target_names) > 0 ? sortBy(root.target_names, #, "asc") : [""],
      let target = #;
      let output_name = target == "" ? root.output_profile + ".md" : target + "_" + root.output_profile + ".md";
      {
        request: {
          selectors: target == "" ? ["."] : [target],
          profile: root.profile,
          check: root.check,
          quiet: root.quiet,
          _output_path: root.output_prefix + output_name,
          _command: "pack",
          _explicit_pack: false,
          _derived_request: true
        },
        target: target == "" ? "(default)" : target,
        file: root.output_prefix + output_name,
        status: root.check ? update_policy.update_status.checked : update_policy.update_status.wrote
      })
  }
}

@macro update_outcomes() {
  {
    ...,
    outcomes: map(.joined_rows, fromPairs([
          ["failed", !#.result_present || !#.ok],
          ["written", #.result_present && #.ok && #.status != update_policy.update_status.checked],
          ["checked", #.result_present && #.ok && #.status == update_policy.update_status.checked],
          ["icon", (!#.result_present || !#.ok) ? "✗" : "✓"],
          ["label", #.target],
          ["detail", !#.result_present ? "target did not produce a result" :
            (!#.ok ? ((#.error ?? "") != "" ? #.error : "target failed without an error message") : #.file)]
    ]))
  }
}

@macro update_report() {
  {
    ...,
    written: len(filter(.outcomes, #.written)),
    checked: len(filter(.outcomes, #.checked)),
    failed: len(filter(.outcomes, #.failed))
  }
  -> match {
    .plan.check -> { ..., message: "Summary: " + string(.checked) + " checked" },
    _ -> { ..., message: "Summary: " + string(.written) + " written" }
  }
  -> match {
    .failed > 0 -> { ..., message: .message + ", " + string(.failed) + " failed" },
    _ -> noop
  }
  -> { summary: {
    outcomes: .plan.quiet ? [] : .outcomes,
    written,
    checked,
    failed,
    message
  } }
}
