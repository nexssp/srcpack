@description "Scaffold workspace configuration and ignore file"
@require github.com/nexssp/srcpack/bundles/init/nexssflow
@require github.com/nexssp/srcpack/bundles/cliinput/nexssflow
@include "init_policy.nflow"

@schema InitInput struct {
  force    bool  `cli:"force,f" usage:"Overwrite existing configuration if present"`
  reset    bool  `cli:"reset" usage:"Remove generated _srcpack files before initializing"`
  dry_run  bool  `cli:"dry-run,check" usage:"Preview changes without writing files"`
  mode     string  `cli:"mode" usage:"Scaffolding mode (default or targets)"`
  dirs     []string  `cli:"positional" usage:"Directories to turn into targets"`
}

@pipeline init
  :cli="init:Create starter nexss.srcpack.yml and ignore file"
  :request-schema=InitInput
  cli.restore
  -> init_policy.pipeline.init_normalize_request
  -> init.inspect
  -> init_policy.pipeline.init_validate_request
  -> match {
    .ok
      -> noop,
    _
      -> { message, kind }
      -> fail
  }
  # Prepare and validate generated content before reset can remove anything.
  -> match(.mode) {
    init_policy.init_mode.targets
      -> init.generate_targets,
    _
      -> init.generate_default
  }
  -> match {
    .reset
      -> match(.dry_run) {
      true
        -> init.preview_clean_generated,
      _
        -> init.clean_generated
    },
    _
      -> noop
  }
  -> match {
    .dry_run
      -> init.preview,
    _
      -> init.write_atomic
  }
  -> init.report_success
@end
