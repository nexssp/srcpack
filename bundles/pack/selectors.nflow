@description "Selector parsing and decisions: path/view precedence, profile selection and metadata"
@require github.com/nexssp/srcpack/bundles/pack
@require github.com/nexssp/repo@v0.8.0
@include "resolution.nflow"

@symbols route {
  pack: "pack"
  tree: "tree"
}

@macro pack_expand_selector_views() {
  {
    ...,
    selected: flatten(map(.ordered,
      !#.forced && !#.path_exists && #.has_view ? #.view : [{selector_text: #.selector_text, forced: #.forced, view_root: ""}]))
  }
}

@macro pack_parse_selector(raw: Expr, forced: Expr, view_root: Expr, profile_aliases: Expr, valid_profiles: Expr) {
  let raw_value = trim($raw);
  let prompt_parts = split(raw_value, "@", 2);
  let without_prompt = trim(prompt_parts[0]);
  let prompt = len(prompt_parts) > 1 ? trim(prompt_parts[1]) : "";
  let hash_parts = split(without_prompt, "#", 2);
  let left = trim(hash_parts[0]);
  let right = len(hash_parts) > 1 ? trim(hash_parts[1]) : "";
  let aliases = fromPairs($profile_aliases);
  let valid_profiles = $valid_profiles;
  let canonical_left = aliases[lower(left)] ?? lower(left);
  let canonical_right = aliases[lower(right)] ?? lower(right);
  let left_is_profile = canonical_left in valid_profiles;
  let right_is_profile = canonical_right in valid_profiles;
  let profile_on_left = len(hash_parts) > 1 && left_is_profile && !right_is_profile;
  let profile = len(hash_parts) > 1 ? (profile_on_left ? canonical_left : canonical_right) : "";
  let target_source = len(hash_parts) > 1 ? (profile_on_left ? right : left) : without_prompt;
  let exclude_parts = split(target_source, "~", 2);
  let target_text = trim(exclude_parts[0]);
  let excludes = len(exclude_parts) > 1 ? filter(map(split(exclude_parts[1], ","), trim(#)), # != "") : [];
  let targets = filter(map(split(target_text, ","), trim(#)), # != "");
  let canonical_raw = aliases[lower(trim(raw_value))] ?? lower(trim(raw_value));
  raw: raw_value,
  forced: $forced,
  view_root: $view_root,
  targets,
  profile,
  prompt,
  excludes,
  bare_profile: !(raw_value contains ",") && !(raw_value contains "#") && !(raw_value contains "~") && !(raw_value contains "@") && canonical_raw in valid_profiles,
  canonical: canonical_raw
}

@macro pack_parse_selected() {
  { ... } as selector_context
  -> { selected: selector_context.selected }
  -> pick (field: "selected")
  -> each {
    { ..., view_root: .view_root ?? "" }
    -> { @pack_parse_selector(.selector_text, .forced, .view_root, selector_context.profile_aliases, selector_context.valid_profiles) }
  }
  -> {
    input: selector_context.input,
    cli_bool_flags: selector_context.cli_bool_flags,
    ordered: selector_context.ordered,
    profile: selector_context.profile,
    profile_aliases: selector_context.profile_aliases,
    valid_profiles: selector_context.valid_profiles,
    context_command: selector_context.context_command,
    context_explicit: selector_context.context_explicit,
    tree_output: selector_context.tree_output,
    default_depth: selector_context.default_depth,
    selected: .
  }
  -> packcmd.selector_facts
}

@macro pack_select_candidate_facts() {
  {
    ...,
    selection: let aliases = fromPairs(.profile_aliases);
      let raw_profile = lower(trim(.profile));
      let initial = aliases[raw_profile] ?? raw_profile;
      reduce(.candidates,
        let item = #;
        let take_profile = !item.forced && item.bare_profile && !item.path_exists && #acc.profile == "";
        {
          profile: take_profile ? item.canonical : (#acc.profile == "" && item.profile != "" ? item.profile : #acc.profile),
          selectors: take_profile ? #acc.selectors : concat(#acc.selectors, [item])
        },
        {profile: initial, selectors: []})
  }
}

@macro pack_choose_selectors() {
  @pack_expand_selector_views()
  -> @pack_parse_selected()
  -> @pack_select_candidate_facts()
}

@macro pack_target_metadata() {
  {
    ..., bindings: flatten(map(.selection.selectors, #.bindings))
  }
  -> {
    ...,
    target_profiles: (.input.profile ?? "") != "" ? {} : fromPairs(map(filter(.bindings, #.profile != ""), [#.key, #.profile])),
    target_prompts: fromPairs(map(filter(.bindings, #.has_prompt), [#.key, #.prompt])),
    target_excludes: fromPairs(map(toPairs(groupBy(filter(.bindings, len(#.excludes) > 0), #.key)),
      [#[0], join(flatten(map(#[1], #.excludes)), ",")]))
  }
}

@macro pack_flag_policy() {
  {
    ...,
    command: match((.input._command ?? "pack") != "" ? (.input._command ?? "pack") : (.context_command != "" ? .context_command : "pack")) {
      route.pack -> route.pack ,
      route.tree -> route.tree ,
      _ -> route.pack
    }
  }
  -> {
    ...,
    normalized: {
      command,
      explicit_pack: .input._explicit_pack ?? .context_explicit,
      output: (.input.output ?? "") != "" ? .input.output :
        match(command) {
          route.tree -> .tree_output ,
          _ -> ""
        },
      comments: .cli_bool_flags.comments ?? .input.comments ?? true,
      depth: (.input.depth ?? 0) == 0 ? .default_depth : .input.depth
    },
    overrides: fromPairs(concat(toPairs(.input), toPairs({
      strip_comments: (.cli_bool_flags.comments ?? .input.comments) == nil ? nil : !(.cli_bool_flags.comments ?? .input.comments),
      no_tests: (.input.tests ?? false) ? false : .input.no_tests,
      no_examples: .cli_bool_flags.examples != nil ? !.cli_bool_flags.examples :
        (.input.examples == nil ? .input.no_examples : !.input.examples),
      tree_only: .input.tree_only ?? match(command) {
        route.tree -> true ,
        _ -> null
      },
      tree_depth: .input.tree_depth ?? .input.depth
    })))
  }
}

@pipeline pack_selector_plan
  packcmd.input_facts
  -> @pack_choose_selectors()
  -> match {
    .selection.profile != "" && !(.selection.profile in .valid_profiles)
    ->
    { message: "unknown profile " + toJSON(.selection.profile) + "; valid profiles: " + join(.valid_profiles, ", ") }
    -> fail,
    _
    -> noop
  }
  -> @pack_target_metadata()
  -> @pack_flag_policy()
  -> { ..., profile_ref: .selection.profile != "" ? .selection.profile : "default" }
@end

@pipeline pack_save_view_request
  packcmd.input_facts
  -> { ..., selected: .ordered }
  -> @pack_parse_selected()
  -> { ..., selectors: .candidates }
  -> packcmd.view_request
  -> {
    ...,
    value: map(.selectors,
      join(#.targets, ",") +
      (len(#.excludes) > 0 ? "~" + join(#.excludes, ",") : "") +
      (#.profile != "" ? "#" + #.profile : "") +
      (#.prompt != "" ? "@" + #.prompt : "")
    )
  }
@end

@pipeline pack_resolve
  pipeline.pack_selector_plan
  -> packcmd.typed_input
  -> {
    ...,
    policy: match { _ -> pick (field: "facts") -> resolution.pipeline.pack_resolution_policy }
  }
  -> match {
    .policy.need_diff
    -> packcmd.git_diff,
    _
    -> { ..., diff_content: "" }
  } as build_input
  -> match {
    .policy.options.Since != "" || .policy.options.Modified || .policy.options.Staged
    -> {
      root: ".",
      since: string(build_input.policy.options.Since ?? ""),
      modified: build_input.policy.options.Modified == true,
      staged: build_input.policy.options.Staged == true
    }
    -> repo.changed_paths as changed
    -> packcmd.build_request(
      host: build_input.host,
      policy: build_input.policy,
      diff_content: build_input.diff_content,
      requested_output: build_input.requested_output,
      changed_paths: changed.Paths,
      changed_paths_provided: true
    ),
    _
    -> packcmd.build_request
  }
  -> {
    pack,
    target_profiles,
    target_excludes,
    stats: fromPairs(concat(toPairs(.stats), [["output", .requested_output != "" ? .requested_output : (.stats.output != "" ? .stats.output : .io.output_path)]])),
    render: fromPairs(concat(toPairs(.render), [["output_file", .requested_output != "" ? .requested_output : .render.output_file]])),
    io: fromPairs(concat(toPairs(.io), [["output_path", .requested_output != "" ? .requested_output : .io.output_path]])),
    save_view,
    selectors,
    profile_aliases,
    valid_profiles,
    command
  }
  -> packcmd.request_maps
@end
