@description "Doctor raw YAML config shape gate; typed decoding remains config.Load's responsibility"
@schema DoctorRawConfigShape {
  cwd               *string
  path              *string
  _doctor_yaml      *map[string]any
  targets           *map[string]any
  profiles          *map[string]any
  prompts           *map[string]any
  editors           *map[string]any
  options           *map[string]any
  views             *map[string]any
  dir               *[]any
  files             *[]any
  includes          *[]any
  include_profiles  *[]any
  prompt            any
  start             any
  end               any
}

# Doctor validates the generic YAML representation before config.Load performs
# its authoritative typed decode. Validation failures are deliberately returned
# as data so the doctor can report one config error and retain its context.
@pipeline doctor_validate_shape
  DoctorRawConfigShape.validate ? on_error {
    else
      -> { cwd: .input.cwd, path: .input.path, shape_error: .error.message }
  }
@end

@macro doctor_shape() {
  system.doctor.raw
  -> doctor_schema.pipeline.doctor_validate_shape
}
