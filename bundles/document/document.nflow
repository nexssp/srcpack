@description "Copyable document formatting policy; no SRCPACK or I/O dependency"
@include "./interpolation.nflow" AS interpolation
@symbols editor_format {
  zed: "zed"
  claude: "claude"
  fold: "fold"
  details: "details"
  raw: "raw"
  none: "none"
  text: "text"
  markdown: "markdown"
}

@pipeline document_render
  { ..., config: .config ?? {}, values: .values ?? {}, tree: .tree ?? "", files: .files ?? [] }
  -> { ..., config: {
      editor: .config.editor ?? "",
      prompt: .config.prompt ?? "",
      start: .config.start ?? "",
      end: .config.end ?? "",
      file_start: .config.file_start ?? "",
      file_end: .config.file_end ?? "",
      diff_content: .config.diff_content ?? "",
      no_header: .config.no_header ?? false,
      no_prompt: .config.no_prompt ?? false,
      no_start: .config.no_start ?? false,
      no_end: .config.no_end ?? false
  } }
  -> { ..., editor: lower(trim(.config.editor)) }
  -> { ..., preset: match(.editor) {
      editor_format.zed
      -> { start: "", end: "", file_start: ("```${LANG} ${REL_PATH}${SOURCE_RANGE}\n"), file_end: ("```\n\n") },
      editor_format.claude
      -> { start: "", end: "", file_start: ("<file path=\"${REL_PATH}${SOURCE_RANGE}\" language=\"${LANG}\">\n```${LANG}\n"), file_end: ("```\n</file>\n\n") },
      editor_format.fold
      -> { start: ("<details>\n<summary>📦 Packed Context</summary>\n"), end: ("</details>\n"), file_start: ("<details>\n<summary>${REL_PATH}${SOURCE_RANGE}</summary>\n\n```${LANG}\n"), file_end: ("```\n</details>\n\n") },
      editor_format.details
      -> { start: ("<details>\n<summary>📦 Packed Context</summary>\n"), end: ("</details>\n"), file_start: ("<details>\n<summary>${REL_PATH}${SOURCE_RANGE}</summary>\n\n```${LANG}\n"), file_end: ("```\n</details>\n\n") },
      editor_format.raw
      -> { start: "", end: "", file_start: "", file_end: "" },
      editor_format.none
      -> { start: "", end: "", file_start: "", file_end: "" },
      editor_format.text
      -> { start: "", end: "", file_start: "", file_end: "" },
      _
      -> { start: "", end: "", file_start: ("### ${REL_PATH}${SOURCE_RANGE} (${LANG})\n```${LANG}\n"), file_end: ("```\n\n") }
  } }
  -> {
    ...,
    start: .config.start != "" ? .config.start : .preset.start,
    end: .config.end != "" ? .config.end : .preset.end,
    file_start: .config.file_start != "" ? .config.file_start : .preset.file_start,
    file_end: .config.file_end != "" ? .config.file_end : .preset.file_end,
    included: filter(.files, !#.omitted && (len(#.content) > 0 || len(#.snippets) > 0))
  }
  -> {
    ...,
    files: map(.included, (
        {
          prefix: (.editor == editor_format.raw || .editor == editor_format.none || .editor == editor_format.text) ? "" : (#.prefix ?? ""),
          values: #.values,
          body: len(#.content) > 0 ? #.content : join(reduce(#.snippets, trim(#) != "" ? concat(#acc, [len(#acc) > 0 ? ((#acc[-1] contains "\n" || trim(#) contains "\n") ? "\n\n" : "\n") : "", trim(#)]) : #acc, []), "")
        }
    ))
  }
  -> { blocks: concat(
    .config.diff_content != "" ? [{ parts: [{ text: ("## Git Unified Diff\n```diff\n" + .config.diff_content + "\n```\n\n") }] }] : [],
    !.config.no_header && !.config.no_prompt && .config.prompt != "" ? [{ parts: [{ text: "> " + replace(trim(.config.prompt), "\n", "\n> ") + "\n\n" }] }] : [],
    .tree != "" && !(.config.start contains "${TREE}") ? [{ parts: [{ text: .tree }] }] : [],
    !.config.no_header && !.config.no_start && .start != "" ? [{ parts: [{ text: .start, values, expand: true }] }] : [],
    map(.files, (
        {
          parts: [
            { text: #.prefix, newline: true },
            { text: .file_start, values: #.values, expand: true, newline: true },
            { text: #.body, newline: true },
            { text: .file_end, values: #.values, expand: true, newline: true }
          ]
        }
    )),
    !.config.no_header && !.config.no_end && .end != "" ? [{ parts: [{ text: .end, values, expand: true }] }] : []
    ) }
  -> interpolation.pipeline.document_interpolate
  -> {
    content: reduce(.blocks, #acc + #, ""),
    items: len(.blocks)
  }
@end
