@description "Output policy: Go supplies candidates and performs effects; Flow chooses them"

@symbols output_mode {
  clipboard: "clipboard"
  stdout: "stdout"
  check: "check"
  file: "file"
}

@pipeline output_policy
  {
    path: (.io.stdout ?? false) ? "-" : .io.output_path,
    save_state: !.io.check,
    copy: .io.copy || (!(.io.copy_explicit ?? false) && !(.io.stdout ?? false) && !.io.check && .io.output_path == ""),
    fail_on_change: .io.fail_on_change ?? false,
    preview: .io.preview ?? false,
    quiet: .io.quiet || .io.json,
    json: .io.json,
    color: .io.color ?? "auto",
    started_at: .io.started_at,
    trailing_newline: .io.explicit_pack && !.io.check,
    mode: match {
      (.io.stdout ?? false)
        -> const @{ value: output_mode.stdout },
      (.io.copy || (!(.io.copy_explicit ?? false) && !(.io.stdout ?? false) && !.io.check && .io.output_path == "")) && .io.explicit_output == ""
        -> const @{ value: output_mode.clipboard },
      .io.explicit_pack && !.io.check && .io.explicit_output == "" && .io.config_path == ""
        -> const @{ value: output_mode.stdout },
      .io.output_path == "" || .io.output_path == "-"
        -> const @{ value: output_mode.stdout },
      .io.check
        -> const @{ value: output_mode.check },
      _
        -> const @{ value: output_mode.file }
    }
  }
@end

@macro output_report_policy() {
  match {
    .policy.quiet -> { ..., report_prefix: "", report_suffix: "" },
    _ -> match(.policy.mode) {
      output_mode.check -> { ..., report_prefix: "✓ Checked in ", report_suffix: " (no changes written)\n" },
      output_mode.clipboard -> { ..., report_prefix: "✓ Completed in ", report_suffix: "\nOutput: full rendered context copied to clipboard (no file written)\n" },
      output_mode.stdout -> { ..., report_prefix: "✓ Completed in ", report_suffix: "\nOutput: rendered context written to stdout\n" },
      _ -> { ..., report_prefix: "✓ Completed in ", report_suffix: "\nOutput: wrote context to " + .policy.path + "\n" }
    }
  }
}

@pipeline output_report_policy
  @output_report_policy()
@end

@pipeline emit_output
  match(.policy.mode) {
    output_mode.file
      -> srcpack.write_output,
    output_mode.check
      -> srcpack.check_output,
    output_mode.stdout
      -> srcpack.print_output,
    output_mode.clipboard
      -> runtime.noop,
    _
      -> runtime.fail @{ kind: "validation", message: "unknown output policy" }
  }
  -> match {
    .policy.copy
      -> srcpack.copy_output,
    _
      -> runtime.noop
  }
  -> @output_report_policy()
  -> srcpack.report_output
@end
